rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      match /friends/{fid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
      }
      match /matches/{mid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.mode in ['coop', 'hunt', 'td', 'br', 'race', 'racet']
          && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score < 1000000
          && request.resource.data.t is number;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /save/{sid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /clans/{cid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'count', 'wk', 'wscore', 'best'])
        && exists(/databases/$(database)/documents/clans/$(cid)/members/$(request.auth.uid))
        || (request.auth.uid == resource.data.owner && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deputies', 'owner'])
            && (request.resource.data.owner == resource.data.owner || exists(/databases/$(database)/documents/clans/$(cid)/members/$(request.resource.data.owner))))
        || ((request.auth.uid == resource.data.owner || ('deputies' in resource.data && request.auth.uid in resource.data.deputies))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['desc', 'badge', 'type', 'minLv', 'region'])
            && (!('desc' in request.resource.data) || (request.resource.data.desc is string && request.resource.data.desc.size() <= 60))
            && (!('type' in request.resource.data) || request.resource.data.type in ['open', 'approve', 'invite'])));
      match /reqs/{uid} {
        function staff() {
          let c = get(/databases/$(database)/documents/clans/$(cid)).data;
          return request.auth.uid == c.owner || ('deputies' in c && request.auth.uid in c.deputies);
        }
        allow read: if signedIn() && (request.auth.uid == uid || staff());
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.ok == false
          && request.resource.data.name is string && request.resource.data.name.size() <= 20;
        allow update: if signedIn() && staff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok']) && request.resource.data.ok == true;
        allow delete: if signedIn() && (request.auth.uid == uid || staff());
      }
      match /members/{uid} {
        function canKick() {
          let c = get(/databases/$(database)/documents/clans/$(cid)).data;
          let dep = ('deputies' in c && c.deputies is list) ? c.deputies : [];
          return uid != c.owner && (request.auth.uid == c.owner || (request.auth.uid in dep && !(uid in dep)));
        }
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || canKick());
      }
      match /msgs/{mid} {
        function member() { return exists(/databases/$(database)/documents/clans/$(cid)/members/$(request.auth.uid)); }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member() && request.resource.data.uid == request.auth.uid
          && request.resource.data.k in ['say', 'req']
          && (request.resource.data.k == 'say'
              ? request.resource.data.text is string && request.resource.data.text.size() <= 80
              : request.resource.data.need == 100 && request.resource.data.got == 0 && request.resource.data.claimed == 0);
        allow update: if signedIn() && member() && resource.data.k == 'req' && (
          (resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got', 'donors'])
            && request.resource.data.got == resource.data.got + 10
            && request.resource.data.got <= resource.data.need)
          || (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
            && request.resource.data.claimed <= resource.data.got));
        allow delete: if signedIn() && member() && resource.data.uid == request.auth.uid;
      }
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.size() == 5
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 8;
      allow update: if signedIn() && resource.data.host == request.auth.uid && request.resource.data.host == request.auth.uid;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    match /world/{mid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.t is number;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /market/{oid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seller == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.kind in ['skin', 'acc', 'gem']
        && request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 1000
        && request.resource.data.cur == 0
        && request.resource.data.endAt is int && request.resource.data.endAt > request.time.toMillis()
        && request.resource.data.endAt <= request.time.toMillis() + 86400000
        && request.resource.data.label is string && request.resource.data.label.size() <= 30
        && request.resource.data.sellerName is string && request.resource.data.sellerName.size() <= 20
        && !('bidder' in request.resource.data) && !('buyer' in request.resource.data)
        && !('paid' in request.resource.data) && !('got' in request.resource.data);
      allow update: if signedIn() && (
        (resource.data.status == 'open' && resource.data.seller != request.auth.uid
          && request.time.toMillis() < resource.data.endAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cur', 'bidder', 'bidderName', 'bidT'])
          && request.resource.data.bidder == request.auth.uid
          && request.resource.data.bidderName is string && request.resource.data.bidderName.size() <= 20
          && request.resource.data.cur is int && request.resource.data.cur >= resource.data.price
          && request.resource.data.cur > resource.data.cur && request.resource.data.cur <= 100000)
        || (resource.data.status == 'open' && resource.data.bidder == request.auth.uid
          && request.time.toMillis() >= resource.data.endAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyer', 'buyerName', 'tb'])
          && request.resource.data.status == 'sold' && request.resource.data.buyer == request.auth.uid)
        || (resource.data.status == 'open' && resource.data.seller == request.auth.uid
          && (!('bidder' in resource.data) || request.time.toMillis() > resource.data.get('endAt', 0) + 86400000)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancel')
        || (resource.data.status == 'sold' && resource.data.seller == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid']) && request.resource.data.paid == true)
        || (resource.data.status == 'sold' && resource.data.buyer == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['got']) && request.resource.data.got == true));
      allow delete: if signedIn() && resource.data.seller == request.auth.uid
        && (resource.data.status == 'cancel' || (resource.data.get('paid', false) == true && resource.data.get('got', false) == true));
    }

    match /{board}/{uid} {
      allow read: if signedIn() && board.matches('lb_.*');
      allow write: if signedIn() && board.matches('lb_.*') && request.auth.uid == uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score < 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if signedIn() && board.matches('lb_.*') && request.auth.uid == uid;
    }
  }
}
